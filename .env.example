# Monad RPC for sends, receipts, nonce and the one-time gas estimate.
# Public endpoint works for dry runs; use a dedicated provider (Alchemy/QuickNode) for live trading.
RPC_URL=https://rpc.monad.xyz
# RPC for book reads, eth_blockNumber polling and Trade logs. The public endpoint is the fastest of these
# (~18 ms per read) and this stays under its 25 rps cap: 1 read + 1 getLogs per block + polling every 150 ms.
READ_RPC_URL=https://rpc.monad.xyz
# Optional WebSocket for newHeads. Polling backstop runs regardless.
WS_URL=wss://rpc.monad.xyz

# Leave PRIVATE_KEY unset (or DRY_RUN=true) to simulate: real book, real decisions, orders rest for one
# block and fill when a real print crosses their price.
PRIVATE_KEY=
DRY_RUN=true

# mock | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

# Every block posts one post-only limit order of this size on the side the model picked, this many ticks
# inside the touch (0 joins the best bid/ask). Kuru MON-USDC minimum order is 200 MON; tick is 0.000001.
TRADE_SIZE_MON=200
QUOTE_INSIDE_TICKS=1
MAX_POSITION_MON=1000
BANKROLL_USD=100

# Kuru limit orders draw from the margin account, not the wallet. At startup the bot deposits enough to
# reach these balances. Asks need MON, bids need USDC. Proceeds of fills also land in margin.
MARGIN_MON=600
MARGIN_USDC=20
# MarginAccount for the MON-USDC market. Only change if MARKET changes.
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5

# Monad charges gas on the LIMIT, so the limit is hardcoded and eth_estimateGas never runs in the loop.
# Unset: estimated once at startup (needs margin funds), else 350000. Expect ~0.03 MON per block live.
GAS_LIMIT=
# EIP-1559 type-2 only. Effective price = base fee + priority, so a high cap costs nothing.
# Monad's base fee floor is 100 gwei and eth_maxPriorityFeePerGas is hardcoded at 2 gwei.
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2

PORT=3000

# Futures via Interactive Brokers (src/futures, scripts/ibkr-smoke.ts). Not used by the Monad bot.
# TWS or IB Gateway must be running with the API enabled. Ports: 4002 Gateway paper, 7497 TWS paper, 4001/7496 live.
IB_HOST=127.0.0.1
IB_PORT=4002
# Market data connects as this id, execution as this + 1.
IB_CLIENT_ID=10
# Optional: restrict orders and account queries to one account.
IB_ACCOUNT=
# 1 realtime (needs CME/CBOT data subscriptions), 3 delayed (display only).
IB_MARKET_DATA_TYPE=1
# Execution refuses live ports unless this is true.
IB_LIVE=false
# A market data stream that fails (no subscription, no permissions) is retried every this many seconds.
IB_DATA_RETRY_S=120
# After the Gateway drops (its daily restart), the order connection retries from 5 s, doubling up to this.
IB_RECONNECT_MAX_S=60

# Futures trader (bun run futures). MODEL above picks the model (mock | jev) for futures too.
# sim: real IBKR quotes, simulated fills, nothing sent. ibkr: orders go to IBKR.
FUT_EXEC=sim
# Comma separated: MES, MNQ, ZB
FUT_ROOTS=MES
FUT_DECISION_S=30
FUT_HORIZON_MIN=5
FUT_MODEL_TIMEOUT_MS=5000
FUT_QTY=1
FUT_MAX_CONTRACTS=1
# Long at P(up) >= this, short at P(up) <= 1 - this, flat within FLAT_BAND of 0.5, otherwise keep the position.
FUT_ENTER_PROB=0.6
FUT_FLAT_BAND=0.05
# Anti-churn: act on the average of the last N answers (none until N in a row), keep a position at least this many
# minutes unless a risk gate or the stop takes it out, and go flat before taking the other side.
FUT_SMOOTH_N=2
FUT_MIN_HOLD_MIN=5
FUT_ALLOW_FLIP=false
# Model input: v1 (original) or v2 (moves in units of normal, range and average context, no book sizes).
FUT_STATE=v1
# Log prefix: data/<name>-events.jsonl, -decisions.jsonl, -fills.jsonl. Give a side-by-side instance its own.
FUT_LOG_NAME=futures
FUT_SLIP_TICKS=0
FUT_MAX_SPREAD_TICKS=2
# Protective stop distance in ticks (defaults MES 16, MNQ 40, ZB 8).
FUT_STOP_TICKS_MES=16
FUT_STOP_TICKS_MNQ=40
FUT_STOP_TICKS_ZB=8
# Across all roots per trading day (realized + unrealized - fees). Flatten and stop for the day when reached.
FUT_DAILY_LOSS_USD=150
FUT_ENTRY_CUTOFF_MIN=10
FUT_FLATTEN_WEEKEND_MIN=15
# ibkr only: cancel every open order on the account at startup. Assumes a dedicated account.
FUT_CANCEL_ON_START=true
FUT_FLATTEN_ON_EXIT=false
FUT_RECONCILE_CYCLES=10
FUT_ORDER_TIMEOUT_MS=30000
FUT_DEPTH_ROWS=0
FUT_PORT=3001
